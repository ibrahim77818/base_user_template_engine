<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_user_template_engine" model="ir.module.category">
        <field name="name">User Templates</field>
        <field name="sequence">90</field>
    </record>

    <!-- Managing templates means managing access rights: requires "Access Rights". -->
    <record id="group_user_template_manager" model="res.groups">
        <field name="name">User Template Manager</field>
        <field name="category_id" ref="module_category_user_template_engine"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_erp_manager'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Every "Settings" administrator is a template manager. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_user_template_manager'))]"/>
    </record>

    <record id="rule_user_template_multi_company" model="ir.rule">
        <field name="name">User Template: multi-company</field>
        <field name="model_id" ref="model_res_users_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
