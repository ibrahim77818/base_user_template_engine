<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- User tags                                                    -->
    <!-- ============================================================ -->
    <record id="demo_tag_finance" model="res.users.tag">
        <field name="name">Finance Team</field>
        <field name="color">10</field>
        <field name="description">Accountants and finance controllers.</field>
    </record>
    <record id="demo_tag_sales" model="res.users.tag">
        <field name="name">Sales Team</field>
        <field name="color">4</field>
    </record>
    <record id="demo_tag_management" model="res.users.tag">
        <field name="name">Management</field>
        <field name="color">3</field>
    </record>
    <record id="demo_tag_contractor" model="res.users.tag">
        <field name="name">External Contractors</field>
        <field name="color">1</field>
    </record>

    <!-- ============================================================ -->
    <!-- Templates (applied in ascending sequence)                    -->
    <!-- ============================================================ -->

    <!-- 1. Global baseline: merge only, never overwrites personal choices -->
    <record id="demo_template_global" model="res.users.template">
        <field name="name">Global Baseline</field>
        <field name="sequence">1</field>
        <field name="scope">global</field>
        <field name="apply_mode">merge</field>
        <field name="description">Company-wide defaults: Riyadh timezone, English, main company.</field>
        <field name="tz_policy">own</field>
        <field name="tz">Asia/Riyadh</field>
        <field name="lang_policy">own</field>
        <field name="lang">en_US</field>
        <field name="allowed_company_ids_policy">own</field>
        <field name="allowed_company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids_policy">own</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_allow_export')])]"/>
    </record>

    <!-- 2. Accountants: inherits preferences from the baseline, adds finance rights -->
    <record id="demo_template_accountants" model="res.users.template">
        <field name="name">Accountants</field>
        <field name="sequence">20</field>
        <field name="scope">targeted</field>
        <field name="parent_id" ref="demo_template_global"/>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_finance')])]"/>
        <field name="apply_mode">merge</field>
        <field name="tz_policy">inherit</field>
        <field name="tz_mode">override</field>
        <field name="allowed_company_ids_policy">inherit</field>
        <field name="group_ids_policy">own</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_multi_currency'), ref('base.group_partner_manager')])]"/>
    </record>

    <!-- 3. Sales reps: contact creation, but no export -->
    <record id="demo_template_sales" model="res.users.template">
        <field name="name">Sales Reps</field>
        <field name="sequence">20</field>
        <field name="scope">targeted</field>
        <field name="parent_id" ref="demo_template_global"/>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_sales')])]"/>
        <field name="apply_mode">merge</field>
        <field name="tz_policy">inherit</field>
        <field name="group_ids_policy">own</field>
        <field name="group_ids" eval="[Command.set([ref('base.group_partner_manager')])]"/>
        <field name="group_remove_ids_policy">own</field>
        <field name="group_remove_ids" eval="[Command.set([ref('base.group_allow_export')])]"/>
    </record>

    <!-- 4. Managers: child of Accountants (multi-level inheritance) -->
    <record id="demo_template_management" model="res.users.template">
        <field name="name">Finance Managers</field>
        <field name="sequence">30</field>
        <field name="scope">targeted</field>
        <field name="parent_id" ref="demo_template_accountants"/>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_management')])]"/>
        <field name="apply_mode">merge</field>
        <field name="tz_policy">inherit</field>
        <field name="group_ids_policy">inherit</field>
    </record>

    <!-- 5. Contractors: strict override, highest precedence -->
    <record id="demo_template_contractors" model="res.users.template">
        <field name="name">Restricted Contractors</field>
        <field name="sequence">90</field>
        <field name="scope">targeted</field>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_contractor')])]"/>
        <field name="apply_mode">override</field>
        <field name="description">Strips every extra right: contractors keep Internal User only.</field>
        <field name="tz_policy">own</field>
        <field name="tz">UTC</field>
        <field name="group_ids_policy">own</field>
        <field name="group_ids" eval="[Command.clear()]"/>
    </record>

    <!-- 6. Archived example (ignored by the engine) -->
    <record id="demo_template_archived" model="res.users.template">
        <field name="name">Legacy Template (archived)</field>
        <field name="sequence">50</field>
        <field name="active" eval="False"/>
        <field name="scope">global</field>
        <field name="tz_policy">own</field>
        <field name="tz">Europe/London</field>
        <field name="apply_mode">override</field>
    </record>

    <!-- ============================================================ -->
    <!-- Demo users (templates apply automatically on creation)       -->
    <!-- ============================================================ -->
    <record id="demo_user_accountant" model="res.users">
        <field name="name">Sara Accountant</field>
        <field name="login">ute_accountant</field>
        <field name="password">ute_accountant</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_user')])]"/>
        <field name="tz">Europe/Paris</field>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_finance')])]"/>
    </record>

    <record id="demo_user_sales" model="res.users">
        <field name="name">Omar Sales</field>
        <field name="login">ute_sales</field>
        <field name="password">ute_sales</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_user')])]"/>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_sales')])]"/>
    </record>

    <record id="demo_user_manager" model="res.users">
        <field name="name">Layla Finance Manager</field>
        <field name="login">ute_manager</field>
        <field name="password">ute_manager</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_user')])]"/>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_finance'), ref('demo_tag_management')])]"/>
    </record>

    <record id="demo_user_contractor" model="res.users">
        <field name="name">Khalid Contractor</field>
        <field name="login">ute_contractor</field>
        <field name="password">ute_contractor</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.set([ref('base.main_company')])]"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_user'), ref('base.group_partner_manager')])]"/>
        <field name="tag_ids" eval="[Command.set([ref('demo_tag_sales'), ref('demo_tag_contractor')])]"/>
    </record>

    <!-- Tag the standard demo user and synchronise every existing user once -->
    <record id="base.user_demo" model="res.users">
        <field name="tag_ids" eval="[Command.link(ref('demo_tag_sales'))]"/>
    </record>

    <function model="res.users.template" name="_cron_apply_all"/>
</odoo>
