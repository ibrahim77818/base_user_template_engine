<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_tag_list" model="ir.ui.view">
        <field name="name">res.users.tag.list</field>
        <field name="model">res.users.tag</field>
        <field name="arch" type="xml">
            <tree string="User Tags">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="user_count"/>
                <field name="template_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_res_users_tag_form" model="ir.ui.view">
        <field name="name">res.users.tag.form</field>
        <field name="model">res.users.tag</field>
        <field name="arch" type="xml">
            <form string="User Tag">
                <header>
                    <button name="action_open_apply_wizard" type="object" string="Apply Templates"
                            class="btn-primary" icon="fa-magic" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="user_count" widget="statinfo" string="Users"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Finance Team"/></h1>
                    </div>
                    <group>
                        <field name="color" widget="color_picker"/>
                        <field name="template_ids" widget="many2many_tags"/>
                        <field name="description"/>
                    </group>
                    <field name="user_ids">
                        <tree>
                            <field name="name"/>
                            <field name="login"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_users_tag_search" model="ir.ui.view">
        <field name="name">res.users.tag.search</field>
        <field name="model">res.users.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_ids"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_res_users_tag" model="ir.actions.act_window">
        <field name="name">User Tags</field>
        <field name="res_model">res.users.tag</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
