<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_template_apply_wizard_form" model="ir.ui.view">
        <field name="name">res.users.template.apply.wizard.form</field>
        <field name="model">res.users.template.apply.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply User Templates">
                <group>
                    <group string="Who">
                        <field name="target" widget="radio"/>
                        <field name="user_ids" widget="many2many_tags" invisible="target != 'users'"
                               required="target == 'users'"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                               invisible="target != 'tags'" required="target == 'tags'"/>
                        <field name="target_count" string="Users in Scope"/>
                    </group>
                    <group string="What">
                        <field name="strategy" widget="radio"/>
                        <field name="template_ids" widget="many2many_tags"
                               invisible="strategy != 'selected' and target != 'audience'"
                               required="strategy == 'selected' or target == 'audience'"/>
                    </group>
                </group>
                <separator string="Preview of changes (dry run)"/>
                <field name="preview_html" nolabel="1"/>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_res_users_template_apply_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Apply Templates</field>
        <field name="res_model">res.users.template.apply.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- "Action" menu bindings for bulk application from list views -->
    <record id="action_apply_templates_from_users" model="ir.actions.act_window">
        <field name="name">Apply User Templates</field>
        <field name="res_model">res.users.template.apply.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[Command.link(ref('group_user_template_manager'))]"/>
    </record>

    <record id="action_apply_templates_from_tags" model="ir.actions.act_window">
        <field name="name">Apply User Templates</field>
        <field name="res_model">res.users.template.apply.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_res_users_tag"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
